# Copy to .env at the repository root. Defaults run locally without credentials.
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
DEMO_MODE=true
STORAGE=file
DATA_FILE=./data/nexus.json
# Set STORAGE=mongo to use MongoDB; connection failures never silently fall back.
MONGODB_URI=mongodb://127.0.0.1:27017/bharatskill_nexus
# Required outside demo mode: at least 32 random characters.
JWT_SECRET=
PAYMENT_MODE=sandbox
# Testnet: set PAYMENT_MODE=testnet, configure receiver, use scripts/pay-testnet.ts
AVM_ADDRESS=
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# Optional explanation provider. Never used to calculate scores.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Testnet payer mnemonic only used by the explicit local payment CLI.
AVM_MNEMONIC=


# Public Vercel preview: DEMO_MODE=false, PAYMENT_MODE=disabled, STORAGE=mongo.
# Exact HTTPS project origin in CLIENT_ORIGIN; never use file storage on Vercel.
# Set only to the known trusted proxy hop count for your deployment.
TRUST_PROXY_HOPS=0

# Passwordless email sign-in. Required for public users; never use VITE_ variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address allowed by your SMTP provider. Gmail: use the same address as SMTP_USER.
EMAIL_FROM=
# With no SMTP host/user/password, only local non-production demo requests show a test code.

# Comma-separated admin emails. Each requires real email OTP verification. Empty disables admin.
ADMIN_EMAILS=

# Optional AI backup: Gemini -> Groq -> built-in progress guidance. Server-only keys.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
