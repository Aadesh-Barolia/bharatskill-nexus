{
  "name": "bharatskill-nexus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @nexus/server\" \"npm run dev -w @nexus/web\"",
    "build": "npm run build -w @nexus/server && npm run build -w @nexus/web && tsc -p tsconfig.vercel.json",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "test": "npm run test -w @nexus/server",
    "test:e2e": "playwright test",
    "test:mongo": "tsx scripts/mongo-smoke.ts",
    "seed": "npm run seed -w @nexus/server",
    "start": "npm run start -w @nexus/server",
    "format": "prettier --write apps packages scripts tests docs *.json *.ts *.md",
    "test:testnet": "tsx scripts/testnet-smoke.ts",
    "pay:testnet": "tsx scripts/pay-testnet.ts",
    "test:production": "tsx scripts/production-smoke.ts",
    "test:vercel": "tsx scripts/vercel-smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
